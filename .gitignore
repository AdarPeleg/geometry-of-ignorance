results_v2/*.json
results/*.json

# Logs
*.log
*.jsonl

# Python bytecode
__pycache__/
*.pyc
*.pyo

# NumPy arrays (large direction vectors)
*.npz

# Environment
.env
*.env

# OS artifacts
.DS_Store
Thumbs.db
